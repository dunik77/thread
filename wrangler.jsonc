{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thread",
  "main": "worker.mjs",
  "compatibility_date": "2026-09-08",
  "build": {
    "command": "npm run build:site"
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  }
}
